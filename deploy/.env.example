# Copy to deploy/.env and fill in. .env is git-ignored: never commit it.

# The public host name; its DNS A/AAAA record must point at this machine and
# ports 80 and 443 must be open, so Caddy can get a certificate.
EVO_DOMAIN=game.example.org
# Contact for Let's Encrypt (expiry warnings).
ACME_EMAIL=admin@example.org

# PostgreSQL password, used in a URL: letters and digits only.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Worlds (README "Several worlds"), `;`-separated. Empty: one world, `main`.
# EVO_WORLDS=main,name=Mainland;isle,seed=7,size=96,name=The Isle
EVO_WORLDS=

# Password hashes run at once (logins, registrations); empty: half the cores.
EVO_HASH_CONCURRENCY=

# Web Push (README "Push notifications"). The contact push services see:
# a real mailto: or https: URL.
EVO_VAPID_SUBJECT=mailto:admin@example.org
# Optional: the VAPID private key (raw P-256 scalar, base64url). Empty: the
# server generates one on first start and keeps it in PostgreSQL
# (server_secrets), so backing up the database backs it up too.
EVO_VAPID_PRIVATE_KEY=

# Native push in the apps (README "Native push in the apps"): off unless set.
# Put the key files in deploy/secrets/ (mounted read-only at
# /run/secrets/evo), readable by the container's user (uid 10001):
#   sudo chown 10001 secrets/* && sudo chmod 400 secrets/*
# Android, FCM service-account JSON:
EVO_FCM_SERVICE_ACCOUNT=
# EVO_FCM_SERVICE_ACCOUNT=/run/secrets/evo/fcm-service-account.json
# iOS, APNs .p8 key with its key id and team id:
EVO_APNS_KEY=
# EVO_APNS_KEY=/run/secrets/evo/AuthKey_XXXXXXXXXX.p8
EVO_APNS_KEY_ID=
EVO_APNS_TEAM_ID=
# Default org.evolutionmmo.client; set if your bundle id differs.
EVO_APNS_TOPIC=
# 1 for development-signed builds (Apple's sandbox).
EVO_APNS_SANDBOX=

# Logging (tracing EnvFilter syntax), e.g. info or evo_server=debug.
RUST_LOG=info

# The image compose builds and runs (set to a pulled tag to skip building).
# EVO_IMAGE=evo-server:latest
# The network between Caddy and evo-server, and Caddy's fixed address on it
# (the only address whose X-Forwarded-For evo-server believes). Change only
# if the subnet collides with one on this host.
# EVO_WEB_SUBNET=172.30.89.0/24
# EVO_PROXY_IP=172.30.89.10
