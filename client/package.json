{
  "name": "evo-client",
  "private": true,
  "version": "0.1.0",
  "description": "Web client for the Evolution MMO (PixiJS + Vite + TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
