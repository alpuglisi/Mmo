{
  "name": "evo-client",
  "private": true,
  "version": "0.1.0",
  "description": "Web client for the Evolution MMO (PixiJS + Vite + TypeScript).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs && node e2e/context-loss.mjs && node e2e/mobile.mjs && node e2e/onboarding.mjs && node e2e/push.mjs && node e2e/android-desktop.mjs && node e2e/builder.mjs && node e2e/vision.mjs",
    "e2e:vision": "node e2e/vision.mjs",
    "e2e:builder": "node e2e/builder.mjs",
    "e2e:android-desktop": "node e2e/android-desktop.mjs",
    "e2e:android": "bash e2e/android-emulator.sh",
    "e2e:push": "node e2e/push.mjs",
    "e2e:onboarding": "node e2e/onboarding.mjs",
    "e2e:smoke": "node e2e/smoke.mjs",
    "e2e:context-loss": "node e2e/context-loss.mjs",
    "e2e:mobile": "node e2e/mobile.mjs",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "npm run build && cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "capacitor:copy:after": "node scripts/ios-ats.mjs",
    "ios:build-sim": "bash scripts/ios-build-sim.sh",
    "e2e:ios": "bash e2e/ios-simulator.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
